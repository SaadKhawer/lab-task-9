          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', 'test' + Date.now() + '@lab09.dev');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Token returned', function () { pm.expect(pm.response.json().access_token).to.not.be.undefined; });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('testToken', json.access_token);"
                ]
              }
            }
          ]
        }
      ]
