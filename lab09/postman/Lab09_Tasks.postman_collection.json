              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Only title changed', function () { var j = pm.response.json(); pm.expect(j.title).to.eql('New'); pm.expect(j.content).to.eql('keep me'); });"
                ]
